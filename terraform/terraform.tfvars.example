# =============================================================================
# xWAR Engine Terraform Variables
# =============================================================================
# Copy this file to terraform.tfvars and set values. S3 bucket names must be
# globally unique across all AWS accounts.
# =============================================================================

# -----------------------------------------------------------------------------
# Required (no defaults)
# -----------------------------------------------------------------------------
data_lake_bucket_name       = "xwar-engine-data-lake"   # Medallion data lives under bronze/silver/gold prefixes

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------
region      = "us-east-1"
environment = "dev"
name_prefix = "xwar-engine"

# Optional: extra tags applied to all resources
tags = {
  # Owner = "data-team"
  # CostCenter = "xwar-engine"
}

# -----------------------------------------------------------------------------
# Pipeline schedule (one EventBridge rule starts the bronze -> silver -> gold
# Step Functions state machine; each stage waits on the previous one)
# -----------------------------------------------------------------------------
pipeline_schedule_expression             = "cron(0 22 * * ? *)"  # 10 PM UTC daily — prior day's data has landed upstream

# -----------------------------------------------------------------------------
# Bronze ingestion Lambda (daily run, all bronze sources; same image used for backfill)
# -----------------------------------------------------------------------------
bronze_ingestion_s3_prefix               = "bronze/statcast"
bronze_ingestion_memory_size             = 1024
bronze_ingestion_timeout                 = 300
bronze_ingestion_image_tag               = "latest"

# -----------------------------------------------------------------------------
# Silver build Lambda (daily run; archetype features + standard stat lines)
# -----------------------------------------------------------------------------
silver_s3_prefix                         = "silver"
gold_s3_prefix                           = "gold/features"
silver_memory_size                       = 1024
silver_timeout                           = 900
silver_image_tag                         = "latest"

log_retention_days = 14